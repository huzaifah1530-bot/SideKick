diff --git a/AltStore/Core/DataSources/PrefetchTaskRegistry.swift b/AltStore/Core/DataSources/PrefetchTaskRegistry.swift
new file mode 100644
index 0000000..3672d16
--- /dev/null
+++ b/AltStore/Core/DataSources/PrefetchTaskRegistry.swift
@@ -0,0 +1,54 @@
+import Foundation
+
+/// Owns one generation of prefetch work per key. A canceled loader may finish
+/// late, so only its own token can remove the registration. Locking also covers
+/// background prefetch completions racing UIKit's cancellation callbacks.
+final class PrefetchTaskRegistry<Key: Hashable>: @unchecked Sendable {
+    private struct Entry {
+        let token: UUID
+        var task: Task<Void, Never>?
+    }
+    private let lock = NSLock()
+    private var entries: [Key: Entry] = [:]
+
+    func contains(_ key: Key) -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+        return entries[key] != nil
+    }
+
+    func begin(at key: Key) -> UUID {
+        let token = UUID()
+        lock.lock()
+        let previous = entries.updateValue(Entry(token: token, task: nil), forKey: key)
+        lock.unlock()
+        previous?.task?.cancel()
+        return token
+    }
+
+    func install(_ task: Task<Void, Never>, at key: Key, token: UUID) {
+        lock.lock()
+        if entries[key]?.token == token {
+            entries[key]?.task = task
+            lock.unlock()
+        } else {
+            lock.unlock()
+            // Completion or cancellation may happen before Task is installed.
+            task.cancel()
+        }
+    }
+
+    func finish(at key: Key, token: UUID) {
+        lock.lock()
+        defer { lock.unlock() }
+        if entries[key]?.token == token { entries.removeValue(forKey: key) }
+    }
+
+    func cancel(at key: Key) {
+        lock.lock()
+        let entry = entries.removeValue(forKey: key)
+        lock.unlock()
+        entry?.task?.cancel()
+    }
+}
