+    public func removeCertificateData(serialNumber: String) throws {
+        let key = "importedCert_" + serialNumber
+        do {
+            try self.keychain.remove(key)
+        } catch {
+            // Verify below; an absent item is already removed.
+        }
+        guard try self.keychain.getData(key) == nil else {
+            throw NSError(domain: "Keychain", code: 4, userInfo: [NSLocalizedDescriptionKey: "The certificate keychain item could not be removed."])
+        }
+    }
+
+    public func clearCertificatesThrowing() throws {
+        let dataKeys = ["signingCertificate", "signingCertificatePrivateKey"]
+        let stringKeys = ["signingCertificatePassword", "signingCertificateSerialNumber"]
+
+        for key in dataKeys + stringKeys {
+            do {
+                try self.keychain.remove(key)
+            } catch {
+                // A missing item is already cleared; verify all keys below and surface any
+                // item that remains instead of treating a failed delete as success.
+            }
+        }
+
+        for key in dataKeys {
+            if try self.keychain.getData(key) != nil {
+                throw NSError(domain: "Keychain", code: 2, userInfo: [NSLocalizedDescriptionKey: "The signing certificate keychain item could not be removed."])
+            }
+        }
+        for key in stringKeys {
+            if try self.keychain.getString(key) != nil {
+                throw NSError(domain: "Keychain", code: 3, userInfo: [NSLocalizedDescriptionKey: "The signing certificate keychain item could not be removed."])
+            }
+        }
+    }
     
