diff --git a/Sources/AuthenticationDiagnostics.swift b/Sources/AuthenticationDiagnostics.swift
new file mode 100644
--- /dev/null
+++ b/Sources/AuthenticationDiagnostics.swift
@@ -0,0 +1,23 @@
+import Foundation
+
+/// This notification carries allowlisted stages and numeric codes only. Never
+/// forward the ordinary debug logger: it can contain credential-bearing values.
+public enum AuthenticationDiagnostics {
+    public enum Stage: String, Sendable {
+        case anisette, authInit, authComplete, authTokens, twoFactor, twoFactorVerify, developerTeam
+    }
+    public enum Event: String, Sendable { case started, succeeded, failed, response }
+    @TaskLocal public static var operationID: UUID?
+    @TaskLocal public static var entryPoint: String?
+    public static let notification = Notification.Name("SideSign.AuthenticationDiagnostics")
+
+    public static func record(_ stage: Stage, event: Event, httpStatus: Int? = nil, code: Int? = nil, challengeStatus: Int? = nil) {
+        guard let operationID, let entryPoint else { return }
+        var fields: [String: Any] = ["operationID": operationID.uuidString,
+            "operation": entryPoint, "stage": stage.rawValue, "event": event.rawValue]
+        if let httpStatus { fields["httpStatus"] = httpStatus }
+        if let code { fields["code"] = code }
+        if let challengeStatus { fields["challengeStatus"] = challengeStatus }
+        NotificationCenter.default.post(name: notification, object: nil, userInfo: fields)
+    }
+}
