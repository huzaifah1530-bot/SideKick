new file mode 100644
--- /dev/null
+++ b/Sources/AuthCompatibility.swift
@@ -0,0 +1,29 @@
+import Foundation
+
+// Compatibility policy shared by the remote provisioning and authentication flows.
+enum AuthCompatibility {
+    // anisette-v3-server Base64-decodes this field into the UUID bytes.
+    static func remoteIdentifier(_ bytes: [UInt8]) -> String {
+        Data(bytes).base64EncodedString()
+    }
+
+    static func authType(statusType: String?, responseType: String?, statusCode: Int?) -> String? {
+        let status = statusType.flatMap { $0.isEmpty ? nil : $0 }
+        let response = responseType.flatMap { $0.isEmpty ? nil : $0 }
+        return status ?? response ?? (statusCode == 409 ? "pushedCode" : nil)
+    }
+
+    static func withProvisioningRecovery<T>(
+        existingBlob: Data?, isRemote: Bool,
+        isProvisioningError: (Error) -> Bool,
+        isolation: isolated (any Actor)? = #isolation,
+        operation: (Data?) async throws -> T
+    ) async throws -> T {
+        do { return try await operation(existingBlob) }
+        catch {
+            guard isRemote, existingBlob != nil, isProvisioningError(error) else { throw error }
+            // Retry once only; a second rejection or unrelated error escapes to the caller.
+            return try await operation(nil)
+        }
+    }
+}
