diff --git a/Sources/AuthCompatibility.swift b/Sources/AuthCompatibility.swift
new file mode 100644
--- /dev/null
+++ b/Sources/AuthCompatibility.swift
@@ -0,0 +1,62 @@
+import Foundation
+
+// Compatibility policy shared by the remote provisioning and authentication flows.
+enum AuthCompatibility {
+    // anisette-v3-server Base64-decodes this field into the UUID bytes.
+    static func remoteIdentifier(_ bytes: [UInt8]) -> String {
+        Data(bytes).base64EncodedString()
+    }
+
+    // Only the observed initial-handshake challenge may request resynchronization.
+    static func resyncPayload(status: [String: any Sendable]) -> Data? {
+        guard status["hsc"] as? Int == 434, status["ec"] as? Int == -22421 else { return nil }
+        let payload: Data?
+        if let bytes = status["X-Apple-I-MD-DATA"] as? Data { payload = bytes }
+        else if let encoded = status["X-Apple-I-MD-DATA"] as? String, encoded.utf8.count <= 87384 {
+            payload = Data(base64Encoded: encoded)
+        } else { payload = nil }
+        guard let payload, !payload.isEmpty, payload.count <= 65536 else { return nil }
+        return payload
+    }
+
+    static func resyncRequest(identifier: [UInt8], adiBlob: Data, deviceID: String, localUserID: String, challenge: Data) -> [String: String] {
+        ["identifier": remoteIdentifier(identifier), "adi_pb": adiBlob.base64EncodedString(),
+         "sim": challenge.base64EncodedString(), "device_id": deviceID, "md_lu": localUserID]
+    }
+
+    static func withResynchronization<T: Sendable>(
+        initial: T, isolation: isolated (any Actor)? = #isolation,
+        request: (T, Bool) async throws -> [String: any Sendable],
+        resynchronize: ((T, Data) async throws -> T)?
+    ) async throws -> (data: T, response: [String: any Sendable]) {
+        let response = try await request(initial, resynchronize != nil)
+        guard let resynchronize,
+              let status = response["Status"] as? [String: any Sendable],
+              let payload = resyncPayload(status: status) else { return (initial, response) }
+        try Task.checkCancellation()
+        let refreshed = try await resynchronize(initial, payload)
+        try Task.checkCancellation()
+        // The second request cannot admit another challenge. Preserve the SRP exchange.
+        return (refreshed, try await request(refreshed, false))
+    }
+
+    static func authType(statusType: String?, responseType: String?, statusCode: Int?) -> String? {
+        let status = statusType.flatMap { $0.isEmpty ? nil : $0 }
+        let response = responseType.flatMap { $0.isEmpty ? nil : $0 }
+        return status ?? response ?? (statusCode == 409 ? "pushedCode" : nil)
+    }
+
+    static func withProvisioningRecovery<T>(
+        existingBlob: Data?, isRemote: Bool,
+        isProvisioningError: (Error) -> Bool,
+        isolation: isolated (any Actor)? = #isolation,
+        operation: (Data?) async throws -> T
+    ) async throws -> T {
+        do { return try await operation(existingBlob) }
+        catch {
+            guard isRemote, existingBlob != nil, isProvisioningError(error) else { throw error }
+            // Retry once only; a second rejection or unrelated error escapes to the caller.
+            return try await operation(nil)
+        }
+    }
+}
diff --git a/Sources/AuthenticationDiagnostics.swift b/Sources/AuthenticationDiagnostics.swift
new file mode 100644
--- /dev/null
+++ b/Sources/AuthenticationDiagnostics.swift
@@ -0,0 +1,23 @@
+import Foundation
+
+/// This notification carries allowlisted stages and numeric codes only. Never
+/// forward the ordinary debug logger: it can contain credential-bearing values.
+public enum AuthenticationDiagnostics {
+    public enum Stage: String, Sendable {
+        case anisette, anisetteResync, authInit, authComplete, authTokens, twoFactor, twoFactorVerify, developerTeam
+    }
+    public enum Event: String, Sendable { case started, succeeded, failed, response }
+    @TaskLocal public static var operationID: UUID?
+    @TaskLocal public static var entryPoint: String?
+    public static let notification = Notification.Name("SideSign.AuthenticationDiagnostics")
+
+    public static func record(_ stage: Stage, event: Event, httpStatus: Int? = nil, code: Int? = nil, challengeStatus: Int? = nil) {
+        guard let operationID, let entryPoint else { return }
+        var fields: [String: Any] = ["operationID": operationID.uuidString,
+            "operation": entryPoint, "stage": stage.rawValue, "event": event.rawValue]
+        if let httpStatus { fields["httpStatus"] = httpStatus }
+        if let code { fields["code"] = code }
+        if let challengeStatus { fields["challengeStatus"] = challengeStatus }
+        NotificationCenter.default.post(name: notification, object: nil, userInfo: fields)
+    }
+}
