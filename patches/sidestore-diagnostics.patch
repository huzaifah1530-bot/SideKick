diff --git a/SideStore/Core/Anisette/AnisetteProvider.swift b/SideStore/Core/Anisette/AnisetteProvider.swift
--- a/SideStore/Core/Anisette/AnisetteProvider.swift
+++ b/SideStore/Core/Anisette/AnisetteProvider.swift
@@ -11,6 +11,18 @@
 
 enum AnisetteProvider {
     static func fetch(handler: AnisetteServerHandler? = nil) async throws -> ALTAnisetteData {
+        AuthenticationDiagnostics.record(.anisette, event: .started)
+        do {
+            let result = try await fetchSelectedProvider(handler: handler)
+            AuthenticationDiagnostics.record(.anisette, event: .succeeded)
+            return result
+        } catch {
+            AuthenticationDiagnostics.record(.anisette, event: .failed, code: (error as NSError).code)
+            throw error
+        }
+    }
+
+    private static func fetchSelectedProvider(handler: AnisetteServerHandler?) async throws -> ALTAnisetteData {
         if UserDefaults.standard.useOnDeviceAnisette {
             debugLog("[AnisetteProvider] Fetching anisette via On-Device Anisette (ODA)...")
             return try await OnDeviceAnisetteManager.shared.fetchAnisetteData()
