diff --git a/SideStore/Core/Anisette/AnisetteProvider.swift b/SideStore/Core/Anisette/AnisetteProvider.swift
--- a/SideStore/Core/Anisette/AnisetteProvider.swift
+++ b/SideStore/Core/Anisette/AnisetteProvider.swift
@@ -11,12 +11,38 @@
 
 enum AnisetteProvider {
     static func fetch(handler: AnisetteServerHandler? = nil) async throws -> ALTAnisetteData {
+        AuthenticationDiagnostics.record(.anisette, event: .started)
+        do {
+            let result = try await fetchSelectedProvider(handler: handler)
+            AuthenticationDiagnostics.record(.anisette, event: .succeeded)
+            return result
+        } catch {
+            AuthenticationDiagnostics.record(.anisette, event: .failed, code: (error as NSError).code)
+            throw error
+        }
+    }
+
+    private static func fetchSelectedProvider(handler: AnisetteServerHandler?) async throws -> ALTAnisetteData {
         if UserDefaults.standard.useOnDeviceAnisette {
             debugLog("[AnisetteProvider] Fetching anisette via On-Device Anisette (ODA)...")
             return try await OnDeviceAnisetteManager.shared.fetchAnisetteData()
         } else {
             debugLog("[AnisetteProvider] Fetching anisette via remote server...")
             return try await fetchRemote(handler: handler)
+        }
+    }
+
+    // Freeze the selected provider and provisioning before authentication starts.
+    static func resyncHandler(for data: ALTAnisetteData) async -> (@Sendable (ALTAnisetteData, Data) async throws -> ALTAnisetteData)? {
+        guard !UserDefaults.standard.useOnDeviceAnisette,
+              let url = URL(string: UserDefaults.standard.menuAnisetteURL), url.scheme == "https",
+              let encodedBlob = AnisetteConfigManager.shared.anisetteAdiBlob,
+              let blob = Data(base64Encoded: encodedBlob), !blob.isEmpty else { return nil }
+        let identifier = await AnisetteConfigManager.shared.resolveDeviceIdentifier()
+        guard UUID(uuidString: data.deviceID) == identifier else { return nil }
+        let provider = SideSign.RemoteAnisetteDataProvider(serverURL: url)
+        return { current, challenge in
+            try await provider.resynchronize(identifier: identifier, adiBlob: blob, data: current, challenge: challenge)
         }
     }
 
