+    /// Imported certificates keep each app's own bundle ID, like other certificate signers; iOS accepts it. Wildcard profiles
+    /// (`TEAMID.*`) authorize any matching ID, so never use a literal `*`. Needs device testing.
+    static func resolvedBundleIdentifier(for profile: ALTProvisioningProfile, original: String, keepOriginal: Bool = false) -> String {
+        let appID = profile.bundleIdentifier
+        guard !keepOriginal, appID.hasSuffix("*") else { return keepOriginal ? original : appID }
+        return original.hasPrefix(String(appID.dropLast())) ? original : appID
+    }
+
+    private static func profile(in profiles: [ALTProvisioningProfile], for bundleIdentifier: String) -> ALTProvisioningProfile? {
+        profiles.first { $0.bundleIdentifier == bundleIdentifier }
+            ?? profiles.first { $0.bundleIdentifier.hasSuffix("*") && resolvedBundleIdentifier(for: $0, original: bundleIdentifier) == bundleIdentifier }
+    }
+
