+++ b/Common/FFIDispatcher.swift
@@ -40,3 +40,23 @@ public func matchingPriority<T: Sendable>(
         try await body()
     }.value
 }
+
+/// Serializes ownership of native gateway handles while allowing synchronous
+/// callbacks already running on the executor to re-enter safely.
+public final class NativeOperationExecutor: @unchecked Sendable {
+    public let queue: DispatchQueue
+    private let key = DispatchSpecificKey<UUID>()
+    private let identity = UUID()
+
+    public init(label: String) {
+        queue = DispatchQueue(label: label)
+        queue.setSpecific(key: key, value: identity)
+    }
+
+    public func sync<T>(_ body: () throws -> T) rethrows -> T {
+        if DispatchQueue.getSpecific(key: key) == identity {
+            return try body()
+        }
+        return try queue.sync(execute: body)
+    }
+}
