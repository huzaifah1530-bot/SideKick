+                  iterations.end == sequence.content.upperBound else { return false }
+        }
+        guard let algorithm = read(bytes, at: digestInfo.content.lowerBound, limit: digestInfo.content.upperBound),
+              algorithm.tag == 0x30, isAlgorithmIdentifier(bytes, algorithm),
+              let digest = read(bytes, at: algorithm.end, limit: digestInfo.content.upperBound),
+              digest.tag == 0x04, digest.end == digestInfo.content.upperBound else { return false }
+        return true
+    }
+
+    private static func isNonNegativeInteger(_ bytes: [UInt8], _ value: TLV) -> Bool {
+        guard !value.content.isEmpty, bytes[value.content.lowerBound] & 0x80 == 0 else { return false }
