+    private func remove(_ request: AnisetteLibraryCacheRequest, id: UUID) {
+        guard operations[request]?.id == id else { return }
+        operations[request] = nil
+        if activeRequestByTarget[request.targetDirectory] == request {
+            activeRequestByTarget[request.targetDirectory] = nil
+        }
+    }
