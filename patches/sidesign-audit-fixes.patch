+private struct AnisetteLibraryCacheRequest: Hashable, Sendable {
+    let sourceURL: String?
+    let payloadDigest: String?
+    let expectedSHA256: String?
+    let targetDirectory: String
+    let provisioningDirectory: String
+    let clientInfo: String
+}
+
+private actor AnisetteLibraryCacheCoordinator {
+    static let shared = AnisetteLibraryCacheCoordinator()
+
+    private struct InFlight {
+        let id: UUID
+        let task: Task<Void, Error>
+    }
+
+    private var operations: [AnisetteLibraryCacheRequest: InFlight] = [:]
+    private var activeRequestByTarget: [String: AnisetteLibraryCacheRequest] = [:]
+
+    func perform(
+        request: AnisetteLibraryCacheRequest,
+        operation: @escaping @Sendable () async throws -> Void
+    ) async throws {
+        if let inFlight = operations[request] {
+            try await waitFor(inFlight, request: request)
+            return
+        }
+
+        // A different source or client configuration must never write to the
+        // same target concurrently. Wait for that request, then perform our own.
+        while let activeRequest = activeRequestByTarget[request.targetDirectory],
+              let activeOperation = operations[activeRequest] {
+            do { try await activeOperation.task.value } catch { }
+            remove(activeRequest, id: activeOperation.id)
+        }
+
+        // Actor methods are reentrant across awaits, so another caller may
+        // have started this exact request while we waited on a conflicting one.
+        if let inFlight = operations[request] {
+            try await waitFor(inFlight, request: request)
+            return
+        }
+
+        let inFlight = InFlight(id: UUID(), task: Task.detached {
+            try await operation()
+        })
+        operations[request] = inFlight
+        activeRequestByTarget[request.targetDirectory] = request
+        try await waitFor(inFlight, request: request)
+    }
+
+    private func waitFor(_ inFlight: InFlight, request: AnisetteLibraryCacheRequest) async throws {
+        do {
+            try await inFlight.task.value
+            remove(request, id: inFlight.id)
+        } catch {
+            remove(request, id: inFlight.id)
+            throw error
+        }
+    }
