+        let limit = 2_048
+        guard redacted.count > limit else { return redacted }
+        return String(redacted.prefix(limit)) + "… [truncated]"
+    }
+
+    private static func redactingSensitiveValues(in value: String) -> String {
+        let credentialKey = #"(?:access[_-]?token|refresh[_-]?token|idms[_-]?token|gs[_-]?idms[_-]?token|auth(?:entication)?[_-]?token|token|password|cookie|authorization|session(?:[_-]?id)?|identity[_-]?token|secret|anisette)"#
