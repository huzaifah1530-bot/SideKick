+    private static func canonicalFileURL(_ url: URL) -> URL {
+        url.standardizedFileURL.resolvingSymlinksInPath().standardizedFileURL
+    }
+
+    private static func sameCanonicalPath(_ lhs: URL, _ rhs: URL) -> Bool {
+        canonicalFileURL(lhs).path == canonicalFileURL(rhs).path
+    }
+
+    private static func pathsOverlap(_ lhs: URL, _ rhs: URL) -> Bool {
+        let left = canonicalFileURL(lhs).path
+        let right = canonicalFileURL(rhs).path
+        func contains(_ parent: String, _ child: String) -> Bool {
+            if parent == "/" { return child.hasPrefix("/") }
+            return child.hasPrefix(parent + "/")
+        }
+        return left == right || contains(left, right) || contains(right, left)
+    }
+
+    private static func replaceOutput(with stagedURL: URL, at outputURL: URL) throws {
+        let fileManager = FileManager.default
+        let destinationURL = canonicalFileURL(outputURL)
+        let parentURL = destinationURL.deletingLastPathComponent()
+        var isDirectory: ObjCBool = false
+        guard fileManager.fileExists(atPath: parentURL.path, isDirectory: &isDirectory), isDirectory.boolValue else {
+            throw CLIError.invalidArgument("Output directory does not exist: \(parentURL.path)")
+        }
+
+        let replacementURL = parentURL.appendingPathComponent(".sidesign-replacement-\(UUID().uuidString)")
+        try fileManager.copyItem(at: stagedURL, to: replacementURL)
+        defer { try? fileManager.removeItem(at: replacementURL) }
+
+        if fileManager.fileExists(atPath: destinationURL.path) {
+            _ = try fileManager.replaceItemAt(destinationURL, withItemAt: replacementURL, backupItemName: nil, options: [])
+        } else {
+            try fileManager.moveItem(at: replacementURL, to: destinationURL)
+        }
+    }
