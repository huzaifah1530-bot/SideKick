+    private static func read(_ bytes: [UInt8], at offset: Int, limit: Int) -> TLV? {
+        guard offset >= 0, offset < limit, limit <= bytes.count else { return nil }
+        let tag = bytes[offset]
+        var cursor = offset + 1
+        if tag & 0x1F == 0x1F {
+            var sawLast = false
+            while cursor < limit, cursor - offset <= 6 {
+                let part = bytes[cursor]
+                cursor += 1
+                if cursor == offset + 3, part & 0x7F == 0 { return nil }
+                if part & 0x80 == 0 { sawLast = true; break }
+            }
+            guard sawLast else { return nil }
+        }
+        guard cursor < limit else { return nil }
+        let firstLength = bytes[cursor]
+        cursor += 1
+        let length: Int
+        if firstLength & 0x80 == 0 {
+            length = Int(firstLength)
+        } else {
+            let count = Int(firstLength & 0x7F)
+            guard count > 0, count <= 4, cursor + count <= limit, bytes[cursor] != 0 else { return nil }
