+              let explicitContent = read(bytes, at: contentType.end, limit: sequence.content.upperBound),
+              explicitContent.tag == 0xA0, explicitContent.end == sequence.content.upperBound,
+              let payload = read(bytes, at: explicitContent.content.lowerBound, limit: explicitContent.content.upperBound),
+              payload.end == explicitContent.content.upperBound else { return false }
+
+        let contentTypeBytes = Array(bytes[contentType.content])
+        if contentTypeBytes == signedDataContentType {
+            return payload.tag == 0x30 && isSignedData(bytes, payload)
+        }
+        guard contentTypeBytes == dataContentType, payload.tag == 0x04 else { return false }
+        return isAuthenticatedSafe(Array(bytes[payload.content]))
+    }
+
+    private static func isAuthenticatedSafe(_ bytes: [UInt8]) -> Bool {
+        guard let authenticatedSafe = read(bytes, at: 0, limit: bytes.count),
+              authenticatedSafe.tag == 0x30, authenticatedSafe.end == bytes.count else { return false }
+        var cursor = authenticatedSafe.content.lowerBound
+        while cursor < authenticatedSafe.content.upperBound {
+            guard let contentInfo = read(bytes, at: cursor, limit: authenticatedSafe.content.upperBound),
