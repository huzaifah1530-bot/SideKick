+
+private func parseLeadingGlobalOptions(_ args: [String]) -> GlobalOptions {
+    var commandIndex = 0
+    var loggingEnabled = false
+    while commandIndex < args.count {
+        switch args[commandIndex] {
+        case "--verbose", "-vv", "--debug":
+            loggingEnabled = true
+            commandIndex += 1
+        default:
+            return GlobalOptions(commandIndex: commandIndex, loggingEnabled: loggingEnabled)
+        }
+    }
+    return GlobalOptions(commandIndex: commandIndex, loggingEnabled: loggingEnabled)
+}
